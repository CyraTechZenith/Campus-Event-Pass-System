            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.student.MyPassActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".ui.qr.ScanPassActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
