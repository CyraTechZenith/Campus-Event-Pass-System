            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.student.StudentProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.student.StudentDashboardActivity"
