<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background -->
    <item>
        <shape android:shape="rectangle">

            <corners android:radius="18dp"/>

            <gradient
                android:startColor="#7C4DFF"
                android:centerColor="#D94AA8"
                android:endColor="#FF7A45"
                android:angle="0"/>

        </shape>
    </item>

    <!-- Soft white overlay -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape>

            <corners android:radius="16dp"/>

            <gradient
                android:startColor="#18FFFFFF"
                android:endColor="#08FFFFFF"
                android:angle="90"/>

        </shape>

    </item>

    <!-- Decorative translucent blocks -->
    <item
        android:left="18dp"
        android:top="18dp">

        <shape>

            <size
                android:width="60dp"
                android:height="60dp"/>

            <corners android:radius="12dp"/>

            <solid android:color="#20FFFFFF"/>

        </shape>

    </item>

    <item
        android:right="18dp"
        android:top="18dp"
        android:gravity="right">

        <shape>

            <size
                android:width="42dp"
                android:height="42dp"/>

            <corners android:radius="10dp"/>

            <solid android:color="#15FFFFFF"/>

        </shape>

    </item>

    <item
        android:left="90dp"
        android:top="70dp">

        <shape>

            <size
                android:width="30dp"
                android:height="30dp"/>

            <corners android:radius="8dp"/>

            <solid android:color="#25FFFFFF"/>

        </shape>

    </item>

</layer-list>