<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FEF8FB"
    tools:context=".ui.event.EventEntryLogsActivity">

    <!-- Top Bar -->

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:background="@drawable/gradient_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="42dp"
            android:padding="6dp"
            android:src="@drawable/baseline_arrow_back_24"
            app:tint="@android:color/white"/>

        <!-- Page Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="50dp"
            android:text="@string/entry_logs"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </FrameLayout>

    <!-- Search Bar -->

    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="18dp"
        app:cardBackgroundColor="#FEF8FB"
        app:cardCornerRadius="28dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/baseline_search_24"
                app:tint="#777777"/>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_name_roll"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#333333"
                android:textColorHint="#ADADAD"/>

            <ImageButton
                android:id="@+id/btnFilter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/baseline_filter_24"
                app:tint="#7A3FD4"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Filter Chips -->

    <LinearLayout
        android:id="@+id/layoutFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- All -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAll"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/filter_chip"
            app:backgroundTint="@null"
            android:text="@string/filter_all"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold"/>

        <!-- Verified -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerified"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/filter_chip"
            app:backgroundTint="@null"
            android:text="@string/filter_verified"
            android:textAllCaps="false"
            android:textColor="#2E7D32"
            android:textStyle="bold"
            android:textSize="15sp"/>

        <!-- Failed -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFailed"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/filter_chip"
            app:backgroundTint="@null"
            android:text="@string/filter_failed"
            android:textAllCaps="false"
            android:textColor="#C62828"
            android:textStyle="bold"
            android:textSize="15sp"/>

    </LinearLayout>

    <!-- Section Header -->

    <LinearLayout
        android:id="@+id/headerToday"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"

        app:layout_constraintTop_toBottomOf="@id/layoutFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutToday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgTodayArrow"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/baseline_keyboard_arrow_down_24"/>

            <TextView
                android:id="@+id/tvToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today"
                android:textColor="#2F2346"
                android:textSize="24sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Entry Count -->

        <TextView
            android:id="@+id/tvEntryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="#565656"
            tools:text="@string/entries"
            android:text=""/>

    </LinearLayout>

    <!-- Entry List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEntryLogs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="20dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        tools:listitem="@layout/item_entry_log"
        app:layout_constraintTop_toBottomOf="@id/headerToday"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Empty State -->

    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerToday"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/baseline_history_24"
            app:tint="#B8A7E3"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/no_entry_logs"
            android:textColor="#4A3A73"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/logs_will_appear"
            android:textAlignment="center"
            android:textColor="#777777"
            android:textSize="15sp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>